Table users {
  id serial [pk]
  login varchar(50) [not null]
  full_name varchar(150) [not null]
  role varchar(20) [not null, default: `'dispatcher'`]
  created_at timestamp [not null, default: `now()`]
}

Table depots {
  id serial [pk]
  name varchar(100) [not null]
  address varchar(200) [not null]
  capacity int [not null]
}

Table vehicle_types {
  id serial [pk]
  name varchar(50) [not null]
  seats int [not null]
  standing int [not null]
}

Table vehicles {
  id serial [pk]
  depot_id int [not null]
  type_id int [not null]
  plate varchar(15) [not null]
  model varchar(80)
  year_made int
  status varchar(20) [not null, default: `'active'`]
  updated_at timestamp [not null, default: `now()`]
  updated_by int
  deleted_at timestamp
  deleted_by int
}

Table drivers {
  id serial [pk]
  depot_id int [not null]
  first_name varchar(60) [not null]
  last_name varchar(60) [not null]
  license_no varchar(20) [not null]
  phone varchar(20)
  hired_on date [not null, default: `CURRENT_DATE`]
  updated_at timestamp [not null, default: `now()`]
  updated_by int
  deleted_at timestamp
  deleted_by int
}

Table driver_licenses {
  driver_id int
  type_id int
  valid_until date [not null]
  indexes {
    (driver_id, type_id) [pk]
  }
}

Table routes {
  id serial [pk]
  type_id int [not null]
  number varchar(10) [not null]
  name varchar(150) [not null]
  updated_at timestamp [not null, default: `now()`]
  updated_by int
  deleted_at timestamp
  deleted_by int
}

Table stops {
  id serial [pk]
  name varchar(120) [not null]
  lat numeric(9,6) [not null]
  lon numeric(9,6) [not null]
  has_shelter bool [not null, default: `false`]
  updated_at timestamp [not null, default: `now()`]
  updated_by int
  deleted_at timestamp
  deleted_by int
}

Table route_stops {
  route_id int
  stop_order int
  stop_id int [not null]
  km_from_start numeric(6,2) [not null, default: `0`]
  indexes {
    (route_id, stop_order) [pk]
  }
}

Table schedules {
  id serial [pk]
  route_id int [not null]
  day_type varchar(10) [not null]
  first_departure time [not null]
  last_departure time [not null]
  interval_min int [not null]
  updated_at timestamp [not null, default: `now()`]
  updated_by int
}

Table shifts {
  id serial [pk]
  driver_id int [not null]
  vehicle_id int [not null]
  shift_date date [not null]
  start_time time [not null]
  end_time time [not null]
}

Table trips {
  id serial [pk]
  shift_id int [not null]
  route_id int [not null]
  started_at timestamp [not null, default: `now()`]
  finished_at timestamp
  status varchar(15) [not null, default: `'in_progress'`]
  updated_at timestamp [not null, default: `now()`]
  updated_by int
}

Table maintenance {
  id serial [pk]
  vehicle_id int [not null]
  started_on date [not null]
  finished_on date
  description text [not null]
  cost numeric(10,2)
  updated_at timestamp [not null, default: `now()`]
  updated_by int
}

Table fare_types {
  id serial [pk]
  name varchar(50) [not null]
  price numeric(8,2) [not null]
}

Table passengers {
  id serial [pk]
  full_name varchar(150) [not null]
  phone varchar(20)
  email varchar(100)
  created_at timestamp [not null, default: `now()`]
}

Table cards {
  id serial [pk]
  card_number varchar(20) [not null]
  passenger_id int
  fare_type_id int [not null]
  balance numeric(10,2) [not null, default: `0`]
  issued_at timestamp [not null, default: `now()`]
  blocked bool [not null, default: `false`]
  updated_at timestamp [not null, default: `now()`]
  updated_by int
  deleted_at timestamp
  deleted_by int
}

Table card_topups {
  id serial [pk]
  card_id int [not null]
  amount numeric(10,2) [not null]
  created_at timestamp [not null, default: `now()`]
  created_by int
}

Table validations {
  id bigserial [pk]
  card_id int [not null]
  trip_id int [not null]
  stop_id int
  price numeric(8,2) [not null]
  created_at timestamp [not null, default: `now()`]
}

Ref: card_topups.card_id > cards.id
Ref: card_topups.created_by > users.id
Ref: cards.deleted_by > users.id
Ref: cards.fare_type_id > fare_types.id
Ref: cards.passenger_id > passengers.id
Ref: cards.updated_by > users.id
Ref: driver_licenses.driver_id > drivers.id
Ref: driver_licenses.type_id > vehicle_types.id
Ref: drivers.deleted_by > users.id
Ref: drivers.depot_id > depots.id
Ref: drivers.updated_by > users.id
Ref: maintenance.updated_by > users.id
Ref: maintenance.vehicle_id > vehicles.id
Ref: route_stops.route_id > routes.id
Ref: route_stops.stop_id > stops.id
Ref: routes.deleted_by > users.id
Ref: routes.type_id > vehicle_types.id
Ref: routes.updated_by > users.id
Ref: schedules.route_id > routes.id
Ref: schedules.updated_by > users.id
Ref: shifts.driver_id > drivers.id
Ref: shifts.vehicle_id > vehicles.id
Ref: stops.deleted_by > users.id
Ref: stops.updated_by > users.id
Ref: trips.route_id > routes.id
Ref: trips.shift_id > shifts.id
Ref: trips.updated_by > users.id
Ref: validations.card_id > cards.id
Ref: validations.stop_id > stops.id
Ref: validations.trip_id > trips.id
Ref: vehicles.deleted_by > users.id
Ref: vehicles.depot_id > depots.id
Ref: vehicles.type_id > vehicle_types.id
Ref: vehicles.updated_by > users.id
